---
import '../styles/global.css';
import { biz, ga4Id, clarityId } from '../config';
interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = biz.demo } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// LocalBusiness schema (no review/rating markup: the demo's reviews are samples, and markup must only describe real reviews)
const schema = {
  '@context': 'https://schema.org', '@type': 'HVACBusiness', name: biz.name, telephone: biz.phone,
  areaServed: biz.areas.map((a) => ({ '@type': 'City', name: `${a}, FL` })),
  openingHours: 'Mo-Su 07:00-21:00', priceRange: '$$', url: canonical,
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#08497f" />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script is:inline>window.dataLayer = window.dataLayer || []; function track(e, p) { window.dataLayer.push(Object.assign({ event: e }, p || {})); }</script>
  {ga4Id && <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>}
  {ga4Id && <script is:inline define:vars={{ ga4Id }}>function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', ga4Id);</script>}
  {clarityId && <script is:inline define:vars={{ clarityId }}>(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script",clarityId);</script>}
</head>
<body>
  {biz.demo && <div class="demo" role="note"><strong>Demo site</strong> built for a Service Hawk tutorial. {biz.name} is a sample business; the phone number and reviews are samples.</div>}
  <slot />
  <script is:inline>
    // every tap on a phone or text link is a conversion we can count
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href^="tel:"], a[href^="sms:"]');
      if (a) track(a.href.indexOf('tel:') === 0 ? 'call_click' : 'text_click', { placement: a.dataset.place || 'page' });
    });
  </script>
</body>
</html>
