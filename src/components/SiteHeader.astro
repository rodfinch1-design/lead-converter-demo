---
import { biz } from '../config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="site">
  <div class="wrap">
    <a class="logo" href={`${base}/`} aria-label={`${biz.name} home`}>
      <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true"><rect width="34" height="34" rx="9" fill="#0b5fa5"/><path d="M17 7v20M8.3 12l17.4 10M8.3 22l17.4-10" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/></svg>
      <span>{biz.name}</span>
    </a>
    <nav class="head-nav" aria-label="Main">
      <a href={`${base}/services/`}>Services</a>
      <a href={`${base}/service-area/`}>Service area</a>
      <a href={`${base}/ac-repair-cost/`}>Prices</a>
    </nav>
    <a class="head-phone" href={biz.phoneHref} data-place="header">{biz.phone}</a>
    <a class="btn btn-cta head-call" href={biz.phoneHref} data-place="header-btn">Call now</a>
  </div>
</header>
